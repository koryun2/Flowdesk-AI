# Application
ENVIRONMENT=development

# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Database
# SQLite keeps non-Docker setup simple. Compose overrides this with PostgreSQL.
DB_ENGINE=django.db.backends.sqlite3
POSTGRES_DB=flowdesk
POSTGRES_USER=flowdesk
POSTGRES_PASSWORD=flowdesk
DB_HOST=localhost
DB_PORT=5432

# Service communication
AI_SERVICE_URL=http://localhost:8001
DJANGO_API_URL=http://localhost:8000
VITE_API_PROXY_TARGET=http://localhost:8000
REDIS_URL=redis://localhost:6379/0

# AI provider. Leave empty to use the local classifier, embeddings, and agent planner.
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-26b-a4b-it
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Production stack (compose.prod.yaml). The development Compose file ignores these.
# DJANGO_ENV=production
# DJANGO_DEBUG=false
# DJANGO_SECURE_COOKIES=false
# WEB_ORIGIN=http://localhost:8080
# WEB_PORT=8080
# SEED_DEMO=false
